{
  "name": "eventhive-server",
  "version": "1.0.0",
  "private": true,
  "description": "EventHive REST API: Express + PostgreSQL (Sequelize) + MongoDB (Mongoose)",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "seed": "node --env-file-if-exists=.env src/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "pg": "^8.23.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.8"
  }
}
