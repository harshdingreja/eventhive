# Copy this file to .env and change values if your setup differs.
# Node reads .env itself (node --env-file-if-exists=.env), so no dotenv package is needed.

PORT=4000

# PostgreSQL: users, events, registrations (Experiment 10)
DATABASE_URL=postgres://localhost:5432/eventhive

# MongoDB: gate entry logs (Experiment 11)
MONGO_URL=mongodb://127.0.0.1:27017/eventhive

# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Which website is allowed to call this API from a browser (CORS). Comma-separate several.
CLIENT_ORIGIN=http://localhost:5173
